---
// Visible "Sources & Last Updated" block for tax/finance calculators. Renders the cited
// IRS/SSA publications the figures in src/lib/calculators/shared/tax-brackets.ts come from,
// plus a last-verified date and a link to the site-wide disclaimer.
//
// Every URL below was verified live before being added here — do not add a source without
// confirming the URL resolves to the actual publication. If a figure needs a citation you
// can't verify, use a TODO(ben) placeholder instead of guessing.

export interface Source {
  label: string;
  url: string;
  note?: string;
}

interface Props {
  taxYear: string;
  lastVerified: string;
  sources: Source[];
}

const { taxYear, lastVerified, sources } = Astro.props;
---

<section class="card-elevated p-6 md:p-8 mb-10">
  <h2 class="font-semibold text-neutral-900 mb-2 flex items-center gap-2">
    <svg class="w-5 h-5 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
    </svg>
    Sources &amp; Last Updated
  </h2>
  <p class="text-sm text-neutral-500 mb-4">
    Figures on this page reflect <strong>tax year {taxYear}</strong> and were last verified against the sources below on <strong>{lastVerified}</strong>. Tax rules change — always confirm current-year figures with the IRS or a tax professional before filing.
  </p>
  <ul class="space-y-2 text-sm">
    {sources.map((source) => (
      <li>
        <a href={source.url} target="_blank" rel="noopener noreferrer" class="text-primary-600 hover:underline font-medium">
          {source.label}
        </a>
        {source.note && <span class="text-neutral-500"> — {source.note}</span>}
      </li>
    ))}
  </ul>
  <p class="text-sm text-neutral-500 mt-4">
    This calculator provides estimates only and is not tax, financial, or legal advice. Read our full <a href="/disclaimer" class="text-primary-600 hover:underline">financial disclaimer</a>.
  </p>
</section>
