---
import CalculatorLayout from '@layouts/CalculatorLayout.astro';
import { SubstackCalc } from '@components/calculators/SubstackCalc';
import {
  calculateSubstackRevenue,
  calculateNetPerPayment,
  DEFAULT_INPUTS,
  FEE_DATA_LAST_VERIFIED,
} from '@lib/calculators/substack-revenue';

// ---------------------------------------------------------------------------
// Every dollar figure in the copy below is computed at build time by running
// the calculator, not by hand. Fee rates and their sources live in
// `src/lib/calculators/substack-revenue.ts`; the source of truth behind them is
// `docs/facts/creator-payment-fees.md` § 6 (ruling D-011).
// ---------------------------------------------------------------------------
const usd = (n: number) =>
  n.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
const usd0 = (n: number) =>
  n.toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });

// Single recurring payments — one monthly charge or one annual charge.
const p5 = calculateNetPerPayment(5);
const p10 = calculateNetPerPayment(10);
const p50 = calculateNetPerPayment(50);
const p100 = calculateNetPerPayment(100);

// FAQ: 500 paid subscribers at $5/month, all on monthly billing.
const faqFiveHundred = calculateSubstackRevenue({
  ...DEFAULT_INPUTS,
  paidSubscribers: 500,
  monthlyPrice: 5,
  annualPlanPercent: 0,
});

// "How to use": 5,000 free subscribers, 3% convert, $7/month, 30% annual.
const howToExample = calculateSubstackRevenue({
  ...DEFAULT_INPUTS,
  paidSubscribers: 150,
  monthlyPrice: 7,
  freeSubscribers: 5000,
  conversionRate: 3,
  annualPlanPercent: 30,
});

// Benchmark table: $7/month, 3.5% free-to-paid conversion, 40% on annual.
const benchmarkRows = [1000, 5000, 10000, 25000, 50000].map((free) => {
  const paid = Math.round(free * 0.035);
  const r = calculateSubstackRevenue({
    ...DEFAULT_INPUTS,
    paidSubscribers: paid,
    monthlyPrice: 7,
    freeSubscribers: free,
    conversionRate: 3.5,
    annualPlanPercent: 40,
  });
  return { free, paid, monthlyNet: r.monthlyNet, annualNet: r.annualNet, effectiveFeePct: r.effectiveFeePct };
});
const benchmarkFeePct = benchmarkRows[0].effectiveFeePct;

// Worked example: launch at $8/month, 60 paid subscribers, 40% on annual.
const launchInputs = { ...DEFAULT_INPUTS, monthlyPrice: 8, annualPlanPercent: 40 };
const launchMonth1 = calculateSubstackRevenue({ ...launchInputs, paidSubscribers: 60 });
const launchMonth6 = calculateSubstackRevenue({ ...launchInputs, paidSubscribers: 120 });
const launchMonth10 = calculateSubstackRevenue({ ...launchInputs, paidSubscribers: 170 });
const launchAnnualPrice = 8 * 10; // two months free — a convention, not a Substack rule
const launchAnnualMonthly = launchAnnualPrice / 12;

// Pricing lever: net per subscriber at $7 vs $10, all monthly.
const at7 = calculateSubstackRevenue({ ...DEFAULT_INPUTS, paidSubscribers: 100, monthlyPrice: 7, annualPlanPercent: 0 });
const at10 = calculateSubstackRevenue({ ...DEFAULT_INPUTS, paidSubscribers: 100, monthlyPrice: 10, annualPlanPercent: 0 });
const netUpliftPct = Math.round((at10.revenuePerSubscriber / at7.revenuePerSubscriber - 1) * 100);
const upliftAfterChurnPct = Math.round((0.8 * (at10.revenuePerSubscriber / at7.revenuePerSubscriber) - 1) * 100);

const faqs = [
  {
    question: 'How much does Substack take from creators?',
    answer:
      `Substack takes 10% of your revenue. Stripe adds 2.9% + $0.30 per transaction for card processing, plus a 0.7% Billing fee on recurring payments that is charged separately and is not included in the Stripe processing figure Substack shows you. Together that is 13.6% plus $0.30 per payment. Because the fixed $0.30 hits small payments hardest, real total fees range from about ${p100.effectiveFeePct}% on a $100 annual subscription to about ${p5.effectiveFeePct}% on a $5 monthly one.`,
  },
  {
    question: 'What\'s a good Substack conversion rate?',
    answer:
      'Most newsletters convert 2-5% of free subscribers to paid annually. Top performers hit 8-10%. Conversion depends on content value, audience quality, and pricing. $5-10/month is the sweet spot for most niches.',
  },
  {
    question: 'How much do Substack writers make?',
    answer:
      `It varies wildly. The top 10 Substacks each make $1M+/year. Writers with 500 paid subscribers at $5/month on monthly billing earn about ${usd0(faqFiveHundred.annualNet)}/year after fees — the fixed $0.30 per payment takes ${faqFiveHundred.effectiveFeePct}% of gross at that price point. Most writers make under $10K/year. Build a large, engaged free list first.`,
  },
  {
    question: 'Should I offer annual subscriptions on Substack?',
    answer:
      'Usually yes. One annual charge means one $0.30 fixed fee instead of twelve, and annual subscribers churn at about 1/3 the rate of monthly subscribers. Substack does not mandate any discount ratio — you set the monthly and annual prices independently — but two months free is the common convention, and it is what this calculator assumes. Aim for 30-50% of subscribers on annual plans.',
  },
];

const relatedCalculators = [
  {
    name: 'Patreon Earnings',
    description: 'Calculate membership platform earnings',
    href: '/creator/patreon-calculator',
    category: 'Creator',
  },
  {
    name: 'YouTube AdSense Revenue',
    description: 'Estimate your YouTube ad earnings',
    href: '/creator/youtube-adsense-calculator',
    category: 'Creator',
  },
  {
    name: 'Freelancer Hourly Rate',
    description: 'Calculate your ideal freelance rate',
    href: '/freelance/hourly-rate-calculator',
    category: 'Freelance',
  },
  {
    name: 'Etsy Fee Calculator',
    description: 'Calculate Etsy seller fees and profit margins',
    href: '/creator/etsy-fee-calculator',
    category: 'Creator',
  },
];
---

<CalculatorLayout
  ogImage="/og-images/substack-revenue.png"
  title="Substack Calculator - Newsletter Revenue Calculator"
  description="Calculate your Substack newsletter earnings after fees. Project subscriber growth and see your net take-home from paid subscriptions."
  calculatorName="Substack Revenue Calculator"
  category="Creator"
  categorySlug="creator"
  slug="substack-calculator"
  faqs={faqs}
  relatedCalculators={relatedCalculators}
>
  <Fragment slot="intro">
    <section class="mb-8">
      <div class="prose prose-neutral max-w-none">
        <h2>How Substack Newsletter Revenue Works</h2>
        <p>Substack is a newsletter platform that lets writers monetize through paid subscriptions. Unlike advertising-supported platforms where revenue scales with pageviews, Substack's model is simple: readers pay a monthly or annual fee for premium content, and you keep what they pay minus platform and processing fees. This direct-to-reader model gives writers stable, recurring income that does not depend on algorithmic distribution or ad market fluctuations.</p>
        <p>Substack takes a flat 10% of your subscription revenue. Stripe, which handles all payment processing, takes an additional 2.9% plus $0.30 per transaction — and then a <strong>0.7% Billing fee</strong> on top of that, charged on every recurring payment. On a $10 monthly subscription the three fees come to {usd(p10.totalFees)}, so you receive <strong>{usd(p10.net)}</strong>. The per-transaction fixed cost of $0.30 makes lower price points less efficient — a $5 monthly subscription yields {usd(p5.net)} per payment ({p5.effectiveFeePct}% total fees), while a $50 annual subscription yields {usd(p50.net)} per payment ({p50.effectiveFeePct}% total fees) and a $100 annual subscription yields {usd(p100.net)} ({p100.effectiveFeePct}%).</p>
        <h3>The 0.7% Stripe Billing Fee Most Calculators Miss</h3>
        <p>The Billing fee is the line item Substack writers most often overlook, and it is not their fault: it is <em>not</em> included in the "Stripe processing fee" figure shown in Substack's payment breakdown. It appears separately as "Stripe fee" under Transactions &rarr; All Activity, or in the Summary of an individual payout. It also applies to non-card payment methods, not just credit cards.</p>
        <p>If you have seen 0.5% quoted for this fee, that was the legacy rate, and it only ever applied to writers who enabled payments before July 10, 2024. That grandfathering <strong>expired on June 30, 2025</strong> — every Substack writer now pays 0.7%. Fee figures on this page were verified against Substack's own published pricing on {FEE_DATA_LAST_VERIFIED}.</p>
        <h3>Free vs. Paid Subscriber Dynamics</h3>
        <p>Most successful Substack newsletters maintain a large free subscriber base that serves as a conversion funnel for paid subscriptions. The typical conversion rate from free to paid ranges from 2% to 5%, with top-performing newsletters reaching 8-10%. This means you generally need 1,000 to 5,000 free subscribers before paid revenue becomes meaningful. The calculator helps you model this funnel by letting you set your free subscriber count, conversion rate, and pricing to project realistic earnings.</p>
        <p>Annual subscriptions are a critical lever in the Substack model. Substack does not require any particular discount — you set the monthly and annual prices independently — but most writers offer something in the 10-20% range, and this calculator assumes the common "two months free" convention. Annual subscribers churn at roughly one-third the rate of monthly subscribers, and they trigger one $0.30 fixed fee a year instead of twelve. A newsletter with 50% of subscribers on annual plans will have significantly more stable revenue than one relying entirely on monthly billing.</p>
      </div>
    </section>
  </Fragment>

  <SubstackCalc client:visible />

  <Fragment slot="content">
    <section class="mb-10">
      <div class="prose prose-neutral max-w-none">
        <h2>How to Use the Substack Revenue Calculator</h2>
        <p>Start by entering your current free subscriber count and estimated paid conversion rate. Most Substack newsletters convert between 2-5% of free subscribers to paid, so begin with a conservative estimate unless you have existing data. Set your monthly subscription price — the $5-10 range works best for most niches, though specialized B2B content can command $15-30/month.</p>
        <p>Switch to <strong>Advanced mode</strong> to model more realistic scenarios. You can adjust the split between monthly and annual subscribers — aim for 30-50% annual, since these subscribers churn at roughly one-third the rate of monthly ones. Set your monthly churn rate (typically 3-7% for monthly subscribers) to see how retention impacts long-term revenue. The fee breakdown separates all three deductions: Substack's 10% platform fee, Stripe's 2.9% + $0.30 card processing, and Stripe's 0.7% Billing fee on recurring charges.</p>
        <p>Use the projection to understand your growth trajectory. A newsletter with 5,000 free subscribers at a 3% conversion rate and $7/month pricing — 150 paid subscribers, 30% of them on annual plans — grosses {usd(howToExample.monthlyGross)} and nets <strong>{usd(howToExample.monthlyNet)}/month</strong> after all fees, an effective fee rate of {howToExample.effectiveFeePct}%. To increase revenue, focus on growing your free list through cross-promotions and SEO, improving conversion with premium content previews, and reducing churn by delivering consistent value to paid subscribers.</p>
        <p>Remember that annual subscriptions provide better cash flow predictability, significantly lower churn, and one fixed $0.30 fee per year instead of twelve. If your calculator shows high monthly churn eating into growth, consider promoting annual plans more aggressively.</p>
      </div>
    </section>
  </Fragment>

  <Fragment slot="deep-dive">
    <section class="mb-10">
      <div class="prose prose-neutral max-w-none">
        <h2>Substack Revenue Benchmarks by Newsletter Size</h2>
        <p>The table below shows estimated revenue at different subscriber counts, assuming a $7/month price, 3.5% free-to-paid conversion rate, and 40% of paid subscribers on annual plans. Every figure is computed by running the calculator on this page, net of all three deductions: Substack's 10%, Stripe's 2.9% + $0.30, and Stripe's 0.7% Billing fee. At this price and mix the effective fee rate is {benchmarkFeePct}%.</p>
        <table>
          <thead>
            <tr>
              <th>Free Subscribers</th>
              <th>Paid Subscribers</th>
              <th>Monthly Net (est.)</th>
              <th>Annual Net (est.)</th>
            </tr>
          </thead>
          <tbody>
            {benchmarkRows.map((row) => (
              <tr>
                <td>{row.free.toLocaleString('en-US')}</td>
                <td>{row.paid.toLocaleString('en-US')}</td>
                <td>{usd0(row.monthlyNet)}</td>
                <td>{usd0(row.annualNet)}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p>These figures assume steady-state subscriber counts. In practice, you must also account for monthly churn (typically 3-7% for monthly subscribers, 1-2% for annual) and ongoing free-to-paid conversion. A newsletter needs to continually grow its free list to offset paid subscriber churn.</p>

        <h2>Worked Example: From Launch to $1,000/Month</h2>
        <p>You start with 2,000 email subscribers from a blog or social media following. You launch a paid Substack at $8/month, with an annual plan at {usd0(launchAnnualPrice)}/year — two months free, the usual convention. In the first month, 3% convert to paid: 60 paid subscribers, split 60% monthly ($8) and 40% annual ({usd0(launchAnnualPrice)}/12 = {usd(launchAnnualMonthly)} effective monthly).</p>
        <p>Monthly gross comes to {usd(launchMonth1.monthlyGross)}. Substack takes {usd(launchMonth1.substackFee)}, Stripe's card processing takes {usd(launchMonth1.stripeProcessingFee)}, and Stripe's Billing fee takes {usd(launchMonth1.stripeBillingFee)} — {usd(launchMonth1.totalFees)} in total, or {launchMonth1.effectiveFeePct}%. You net <strong>{usd(launchMonth1.monthlyNet)}</strong> in month one.</p>
        <p>Assume you grow your free list by 500 subscribers per month through cross-promotions, SEO, and social sharing, with a 2% ongoing conversion rate on new subscribers. Monthly churn is 5% for monthly subs and 1.5% for annual. By month 6, you would have roughly 120 paid subscribers netting about {usd0(launchMonth6.monthlyNet)}/month. By month 10, roughly 170 paid subscribers put you past the $1,000/month mark at about {usd0(launchMonth10.monthlyNet)} net.</p>

        <h2>Strategies for Growing Substack Revenue</h2>
        <p><strong>Grow the free list relentlessly.</strong> Your free subscriber list is the top of your conversion funnel. Every 1,000 new free subscribers yields 20-50 new paid subscribers at typical conversion rates. Cross-promotions with other newsletter writers, guest appearances on podcasts, and SEO-optimized posts are the most cost-effective growth channels.</p>
        <p><strong>Use the paywall strategically.</strong> Putting your best content behind the paywall gives free readers a reason to upgrade. A common approach is publishing one free post and one paid post per week, with the free post demonstrating your expertise and the paid post delivering actionable depth. Avoid paywalling everything — free content is your marketing.</p>
        <p><strong>Push annual plans aggressively.</strong> Annual subscribers churn less, provide upfront cash flow, and smooth out revenue fluctuations. They also cut the fixed-fee drag: one $0.30 charge a year instead of twelve. Offer a meaningful discount (15-20% off the monthly rate) and promote annual plans in onboarding emails, in posts, and at renewal time. Aim for 40-50% of your paid base on annual billing.</p>
        <p><strong>Raise prices deliberately.</strong> Many Substack writers underprice their work. If your content delivers genuine value — saving readers time, making them money, or providing unique expertise — test price increases. Moving from $7 to $10/month lifts net revenue per monthly subscriber from {usd(at7.revenuePerSubscriber)} to {usd(at10.revenuePerSubscriber)} — a {netUpliftPct}% gain, slightly more than the 43% price rise, because the fixed $0.30 is spread across a larger payment. Some existing subscribers will cancel, but the math usually favors higher prices: even losing 20% of your subscribers, you come out roughly {upliftAfterChurnPct}% ahead on net revenue.</p>
      </div>
    </section>
  </Fragment>
</CalculatorLayout>
